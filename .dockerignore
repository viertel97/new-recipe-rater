# Version control & local tooling
.git
.gitignore
.history
.claude
.superpowers
.worktrees

# Dependencies & build artifacts — reinstalled/rebuilt inside the image
node_modules
.next
out
build
coverage
*.tsbuildinfo

# Runtime media — mounted as a volume (see docker-compose.yml), never baked in
data

# The ig-sync Python service builds from its own context
scripts

# Secrets & local env — must not leak into image layers
.env
.env.*

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
docs
README.md
