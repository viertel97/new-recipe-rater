generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  username  String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  links Link[]
}

model Link {
  id              String   @id @default(cuid())
  url             String   @unique
  rating          Rating   @default(PENDING)
  urgency         Urgency?
  notes           String?
  reviewNote      String?
  tandoorRecipeId Int?
  category        Category?
  categoryStatus  CategoryStatus @default(PENDING)
  categoryError   String?
  categoryAttempts Int @default(0)
  createdAt       DateTime @default(now())

  submittedBy   User   @relation(fields: [submittedById], references: [id])
  submittedById String

  @@index([categoryStatus])
}

enum Rating {
  PENDING
  GOOD
  BAD
}

enum Urgency {
  TOMORROW
  NEXT_WEEK
  NEXT_MONTH
  ARCHIVE
}

enum Category {
  DINNER
  SNACK
  CAKE
  BREAKFAST
}

enum CategoryStatus {
  PENDING
  DONE
  FAILED
}

