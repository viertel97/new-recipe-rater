generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  username  String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  links             Link[]
  sharedCollections SharedCollection[]
}

model Link {
  id              String   @id @default(cuid())
  url             String   @unique
  rating          Rating   @default(PENDING)
  urgency         Urgency?
  notes           String?
  reviewNote      String?
  tandoorRecipeId Int?
  category        Category?
  categoryStatus  CategoryStatus @default(PENDING)
  categoryError   String?
  categoryAttempts Int @default(0)
  createdAt       DateTime @default(now())

  submittedBy   User   @relation(fields: [submittedById], references: [id])
  submittedById String

  mediaAssetId  String?     @unique
  mediaAsset    MediaAsset? @relation(fields: [mediaAssetId], references: [id])
  mediaStatus   MediaStatus @default(PENDING)
  mediaError    String?

  @@index([categoryStatus])
  @@index([mediaStatus])
}

model SharedCollection {
  id          String   @id @default(cuid())
  linkIds     String[]
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

model MediaAsset {
  id            String    @id @default(cuid())
  sourceUrl     String    @unique
  type          MediaType
  blobUrl       String
  contentType   String
  sizeBytes     Int
  thumbnailUrl  String?
  title         String?
  description   String?
  fetchedAt     DateTime  @default(now())

  link Link?
}

enum MediaType {
  VIDEO
  IMAGE
}

enum MediaStatus {
  PENDING
  RESOLVED
  FAILED
  EVICTED
}

enum Rating {
  PENDING
  GOOD
  BAD
}

enum Urgency {
  TOMORROW
  NEXT_WEEK
  NEXT_MONTH
  ARCHIVE
}

enum Category {
  DINNER
  SNACK
  CAKE
  BREAKFAST
}

enum CategoryStatus {
  PENDING
  DONE
  FAILED
}

